# REQUIRED — generate your own, never use this placeholder:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-see-comment-above
FRONTEND_ORIGIN=http://localhost:3000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=internguide
# set to true in production (needs https)
COOKIE_SECURE=false

# Rate-limiter storage. In production point this at Redis so the limit is shared
# across gunicorn workers. Leave it unset locally to use per-process memory.
REDIS_URL=redis://localhost:6379

# SMTP email, used to send the "forgot password" 6-digit code.
# Any provider works (Brevo, Mailtrap, Gmail, ...). Leave SMTP_HOST empty to
# turn emailing off (the app still runs, it just can't send the code).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
SMTP_FROM=noreply@yourdomain.com
SMTP_FROM_NAME=InternGuide
